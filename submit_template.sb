#!/bin/bash
# SLURM submission template used by generate_jobs.py, which symlinks this file
# into every jobs/<job_name>/ folder and runs `sbatch` there, so the working
# directory holds that job's config.json. Adapt the resource lines and the
# module/licence lines to your cluster before submitting.
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=64G
#SBATCH --time=3-00:00:00
#SBATCH --output=slurm-%j.out
##SBATCH --account=<account>
##SBATCH --partition=<partition>

set -euo pipefail

# The repository root is the folder that holds run_model.jl. generate_jobs.py
# --submit exports it as CAPTIVE_REPO_ROOT (sbatch runs a spool copy of this
# script, so its own path is no guide). When submitting by hand from a job
# folder, jobs/<job_name>/ sits two levels below the repository root.
REPO_ROOT="${CAPTIVE_REPO_ROOT:-$(cd "${SLURM_SUBMIT_DIR:-$PWD}/../.." && pwd)}"
[ -f "$REPO_ROOT/run_model.jl" ] || { echo "run_model.jl not found under $REPO_ROOT; set CAPTIVE_REPO_ROOT" >&2; exit 1; }

# module load julia                         # cluster-specific
# export GRB_LICENSE_FILE=/path/to/gurobi.lic   # only for "solver": "gurobi"

julia --project="$REPO_ROOT" "$REPO_ROOT/run_model.jl" --config config.json
